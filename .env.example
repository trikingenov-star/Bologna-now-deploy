# ── Clerk Authentication ────────────────────────────────────────────────────
# From https://dashboard.clerk.com → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ── OpenAI (for AI itinerary, chat, and event translation) ─────────────────
# From https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Events APIs ────────────────────────────────────────────────────────────
# Ticketmaster: https://developer.ticketmaster.com
TICKETMASTER_API_KEY=...

# Eventbrite: https://www.eventbrite.com/platform/api-keys
EVENTBRITE_API_KEY=...

# ── Unsplash (place photos) ────────────────────────────────────────────────
# From https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=...

# ── Google Maps ───────────────────────────────────────────────────────────
# Public key — safe to expose in the frontend
VITE_GOOGLE_MAPS_API_KEY=...

# ── Database (Neon PostgreSQL) ─────────────────────────────────────────────
# Your Neon connection string (used for future DB features)
DATABASE_URL=postgresql://...
